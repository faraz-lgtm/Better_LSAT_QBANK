# Copy to `.env.production.local` (gitignored) for `pnpm run dev:prod`.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-production-publishable-or-anon-key>

# PostHog (product analytics). Client-safe project token; host is the reverse proxy.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=https://e.bettermcat.com
